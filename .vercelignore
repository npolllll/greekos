/GreekOS_APP_HANDOFF_2026-10-29/app/.env*
!/GreekOS_APP_HANDOFF_2026-10-29/app/.env.example
/GreekOS_APP_HANDOFF_2026-10-29/app/.deploy
/GreekOS_APP_HANDOFF_2026-10-29/app/.scratch
/GreekOS_APP_HANDOFF_2026-10-29/app/tests
/GreekOS_APP_HANDOFF_2026-10-29/app/test-results
/GreekOS_APP_HANDOFF_2026-10-29/app/playwright-report
/GreekOS_APP_HANDOFF_2026-10-29/app/local-services
/GreekOS_APP_HANDOFF_2026-10-29/app/backups
