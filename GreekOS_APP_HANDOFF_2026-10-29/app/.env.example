# ---- Supabase (Project Settings → API). Service role key is SERVER ONLY. ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL — only for the corpus import CLI, never set it in Vercel.
DATABASE_URL=
APP_URL=http://127.0.0.1:3210
APP_ENV=local            # local | preview | production
CORPUS_ROOT=../spec/GreekOS_CLAUDE_UPLOAD_READY

# ---- AI (server only). Without it: no AI rubric checks; dialogue follows the authored script. ----
ANTHROPIC_API_KEY=
LLM_MODEL_DIALOGUE=claude-opus-5-5
LLM_MODEL_ASSESSOR=claude-opus-5-5

# ---- Speech (server only). ASR_PROVIDER: openai | azure | local | none. TTS_PROVIDER: openai | azure | google | local | none ----
# local = development engines on this machine only (APP_ENV=local|test): macOS system Greek voice
# (personal/dev licence, never distributed) + Whisper service (`npm run local:asr`).
ASR_PROVIDER=none
TTS_PROVIDER=none
LOCAL_ASR_URL=http://127.0.0.1:3312
LOCAL_ASR_STREAM_FINAL_MODEL=small
# Owner preview of DEV_LOCAL_ONLY lesson audio in local development (never a learner path)
ALLOW_LOCAL_VOICE_PLAYBACK_FOR_DEV=0
OPENAI_API_KEY=
OPENAI_ASR_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICES=coral,onyx,sage,ash
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICES=el-GR-AthinaNeural,el-GR-NestorasNeural
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICES=el-GR-Wavenet-A,el-GR-Standard-B

# ---- Streaming voice gateway (separate long-lived process, NOT a Vercel function) ----
# Secret shared by the app (mints 60 s tokens) and the gateway (verifies them); ≥32 random chars.
VOICE_GATEWAY_SECRET=
VOICE_GATEWAY_PORT=3311
VOICE_GATEWAY_HOST=127.0.0.1
# Public wss:// URL the browser connects to (production: wss://voice.example.com)
NEXT_PUBLIC_VOICE_GATEWAY_URL=
# Extra allowed browser origins for the gateway (comma-separated); APP_URL is always allowed
VOICE_GATEWAY_ALLOWED_ORIGINS=

# ---- Cost guards (USD estimates, not invoices) ----
BUDGET_DAILY_USD_PER_USER=1.5
BUDGET_MONTHLY_USD=40
AUDIO_RUN_BUDGET_USD=5

# ---- Vercel Cron auth ----
CRON_SECRET=

# Tests only: allow labelled synthetic mock transports (refused when APP_ENV=production)
ALLOW_SYNTHETIC_PROVIDERS=0
