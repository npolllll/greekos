# GreekOS — every environment variable, without values. Never commit real values.
# Production: you do NOT edit this file. Put the values into GitHub → Settings → Secrets and variables →
# Actions and run the «GreekOS deploy» workflow (FINAL_DEPLOYMENT_GUIDE.md); it writes them to Vercel and
# Fly.io for you. Locally: copy to .env.local.
#
# [R] required in production · [A] set automatically by scripts/deploy-cloud.sh · [O] optional · [D] development only

# ═══ Supabase (database, sign-in, e-mail, storage) — supabase.com, Free plan, region EU (Frankfurt) ═══
NEXT_PUBLIC_SUPABASE_URL=            # [A] https://<project-ref>.supabase.co (derived from the project ref)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # [R] Project Settings → API → anon / publishable key (public by design, RLS protects data)
SUPABASE_SERVICE_ROLE_KEY=           # [R] Project Settings → API → service_role / secret key. SERVER ONLY — never in the browser
DATABASE_URL=                        # [R] Connect → Session pooler connection string with the DB password (setup + backups only; not in Vercel)
# For the deploy workflow only (GitHub secrets):
# SUPABASE_PROJECT_REF=              # [R] Project Settings → General → Reference ID
# SUPABASE_DB_PASSWORD=              # [R] the database password chosen when creating the project
# SUPABASE_ACCESS_TOKEN=             # [R] supabase.com → Account → Access Tokens (applies migrations + auth/SMTP settings)

# ═══ App ═══
APP_URL=http://127.0.0.1:3210        # [R] production address, e.g. https://greekos.vercel.app (no trailing slash)
APP_ENV=local                        # [A] production on Vercel/Fly; local | test for development
CRON_SECRET=                         # [A] protects the daily retention job (generated)
REGISTRATION_SALT=                   # [A] salt for hashing IPs/e-mails in the registration rate limit (generated)
# OWNER_EMAIL=                       # [R] deploy workflow: the owner account receives the first invitation

# ═══ E-mail (confirmation, password reset, registration) — resend.com Free: 3 000 e-mails/month, no card ═══
# Configured inside Supabase Auth by the deploy script (`supabase config push`), not read by the app.
# SMTP_PASS=                         # [R] Resend → API Keys (it is the SMTP password); any SMTP works (SMTP_HOST/PORT/USER)
# SMTP_SENDER=                       # [R] sender on a domain verified in Resend (SPF/DKIM), e.g. no-reply@your-domain

# ═══ AI (dialogue, writing assessment) — console.anthropic.com, prepaid credits, auto-reload OFF ═══
ANTHROPIC_API_KEY=                   # [R] Console → API Keys. SERVER ONLY
LLM_MODEL_DIALOGUE=claude-haiku-5-5  # [O] most economical current model ($0.10 / $0.50 per million tokens)
LLM_MODEL_ASSESSOR=claude-haiku-5-5  # [O] e.g. claude-sonnet-5-5 for stricter writing feedback (20× the price)
LLM_TURN_TIMEOUT_MS=25000            # [O] per conversation turn

# ═══ Speech (recognition + Greek voices) — portal.azure.com → Speech service, pricing tier F0 (free) ═══
ASR_PROVIDER=none                    # [A] azure in production
TTS_PROVIDER=none                    # [A] azure in production
AZURE_SPEECH_KEY=                    # [R] Speech resource → Keys and Endpoint → KEY 1. SERVER ONLY
AZURE_SPEECH_REGION=                 # [R] westeurope (the region of the resource)
AZURE_SPEECH_TIER=F0                 # [O] F0 = free (0.5 M neural characters + 5 h recognition per month, no charges) | S0 = paid
AZURE_TTS_VOICES=el-GR-AthinaNeural,el-GR-NestorasNeural   # [O] native Greek female / male voices

# ═══ Live voice gateway (WebSocket) — fly.io, one machine that sleeps between conversations ═══
VOICE_GATEWAY_SECRET=                # [A] shared by app and gateway (generated)
NEXT_PUBLIC_VOICE_GATEWAY_URL=       # [A] wss://<fly-app>.fly.dev; empty → AI Speaking in step mode (no gateway, no Fly costs)
VOICE_GATEWAY_PORT=3311              # [D] local gateway port (8080 inside the container)
VOICE_GATEWAY_HOST=127.0.0.1         # [D]
VOICE_GATEWAY_ALLOWED_ORIGINS=       # [O] extra browser origins; APP_URL is always allowed
# FLY_API_TOKEN=                     # [R if gateway] fly.io → Account → Access Tokens (deploy workflow only)

# ═══ Spending ceiling (EUR, all services together) — enforced before every paid call ═══
BUDGET_MONTHLY_EUR_MAX=10            # [O] absolute maximum per month
BUDGET_MONTHLY_EUR_TARGET=5          # [O] target shown in Owner Admin
BUDGET_FIXED_EUR=5.5                 # [O] worst-case fixed costs: domain ≈ 0.85 € + Fly machine all month ≈ 4.6 € (1 without the gateway)
BUDGET_SAFETY_RATIO=0.8              # [O] paid calls stop at (MAX − FIXED) × RATIO = 3.60 € (7.20 € without the gateway)
BUDGET_DAILY_EUR_PER_USER=0.5        # [O] one learner cannot use up the month
BUDGET_USD_TO_EUR=1                  # [O] conservative conversion of USD list prices
BUDGET_TAX_MULTIPLIER=1.24           # [O] VAT reserve (Greece 24 %)
AUDIO_RUN_BUDGET_USD=1               # [O] cap of one course-audio generation run (0 € on Azure F0)
AZURE_TTS_USD_PER_MILLION_CHARS=16   # [O] S0 price used for the guard (F0 = 0)
AZURE_STT_USD_PER_HOUR=1             # [O] S0 price used for the guard (F0 = 0)

# ═══ Development only (refused or ignored in production) ═══
CORPUS_ROOT=../spec/GreekOS_CLAUDE_UPLOAD_READY   # [D] source corpus for `npm run import`
# LLM_PROVIDER=openai_compatible      # [D] local model instead of Claude (npm run local:llm)
# LLM_BASE_URL=http://127.0.0.1:3313  # [D]
# LLM_MODEL=gemma-4-E2B-it-Q4_K_M     # [D]
LOCAL_ASR_URL=http://127.0.0.1:3312  # [D] local Whisper service (npm run local:asr)
LOCAL_ASR_STREAM_FINAL_MODEL=small   # [D]
ALLOW_LOCAL_VOICE_PLAYBACK_FOR_DEV=0 # [D] owner preview of development voices, never learners
ALLOW_SYNTHETIC_PROVIDERS=0          # [D] tests only; refused when APP_ENV=production
# Other providers (supported, not used by the budget plan): OPENAI_API_KEY, OPENAI_ASR_MODEL, OPENAI_TTS_MODEL,
# OPENAI_TTS_VOICES, GOOGLE_TTS_API_KEY, GOOGLE_TTS_VOICES, AZURE_SPEECH_TTS_URL, AZURE_SPEECH_STT_URL,
# GOOGLE_TTS_URL, OPENAI_BASE_URL
