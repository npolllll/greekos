  "phrases": [
    {
      "id": "P01",
      "text": "Καλημέρα σας! Τι κάνετε σήμερα;",
      "focus": "greeting, question"
    },
    {
      "id": "P02",
      "text": "Θα πάμε αύριο στη Θεσσαλονίκη ή στην Αθήνα;",
      "focus": "toponyms, alternative question"
    },
    {
      "id": "P03",
      "text": "Ο ΠΑΟΚ παίζει απόψε στις εννιά και μισή.",
      "focus": "acronym, time"
    },
    {
      "id": "P04",
      "text": "Πότε φεύγει το τρένο; Δεν έχω πάει ποτέ με τρένο.",
      "focus": "stress pair πότε/ποτέ"
    },
    {
      "id": "P05",
      "text": "Πού είναι το βιβλίο που μου έδωσες;",
      "focus": "stress pair πού/που"
    },
    {
      "id": "P06",
      "text": "Μπορείτε να το πείτε λίγο πιο αργά, παρακαλώ;",
      "focus": "polite request"
    },
    {
      "id": "P07",
      "text": "Θέλω ένα κιλό μήλα και δύο κιλά ντομάτες.",
      "focus": "numbers, clusters ντ"
    },
    {
      "id": "P08",
      "text": "Η εκστρατεία ξεκίνησε στις δεκαπέντε Μαρτίου.",
      "focus": "cluster κστρ, date"
    },
    {
      "id": "P09",
      "text": "Ο Γιώργος και η Ελένη μένουν στην Πάτρα.",
      "focus": "personal names, toponym"
    },
    {
      "id": "P10",
      "text": "Συγγνώμη, πού είναι η στάση του λεωφορείου;",
      "focus": "γγ, directions"
    },
    {
      "id": "P11",
      "text": "Το διαμέρισμα έχει δύο υπνοδωμάτια και μεγάλο μπαλκόνι.",
      "focus": "long words, μπ"
    },
    {
      "id": "P12",
      "text": "Δεν ξέρω αν θα έρθω, γιατί έχω πολλή δουλειά.",
      "focus": "negation, conjunctions"
    },
    {
      "id": "P13",
      "text": "Ναι, καλά. Θα σε πάρω τηλέφωνο το απόγευμα.",
      "focus": "colloquial ναι καλά"
    },
    {
      "id": "P14",
      "text": "Το εισιτήριο κοστίζει δεκαοχτώ ευρώ και πενήντα λεπτά.",
      "focus": "prices"
    },
    {
      "id": "P15",
      "text": "Έχετε κράτηση; Για πόσα άτομα;",
      "focus": "short questions"
    },
    {
      "id": "P16",
      "text": "Ο γιατρός είπε να παίρνω το φάρμακο δύο φορές την ημέρα.",
      "focus": "pharmacy, frequency"
    },
    {
      "id": "P17",
      "text": "Η Ακρόπολη και ο Λευκός Πύργος είναι πολύ γνωστά μνημεία.",
      "focus": "landmarks"
    },
    {
      "id": "P18",
      "text": "Μου αρέσει να διαβάζω, αλλά δεν έχω χρόνο.",
      "focus": "clitics"
    },
    {
      "id": "P19",
      "text": "Πήγα στο σούπερ μάρκετ και αγόρασα καφέ και ψωμί.",
      "focus": "loanwords, ψ"
    },
    {
      "id": "P20",
      "text": "Τον Αύγουστο το Αιγαίο έχει πολύ αέρα.",
      "focus": "diphthongs αυ/αι"
    },
    {
      "id": "P21",
      "text": "Αν βρέξει, θα μείνουμε σπίτι και θα δούμε ταινία.",
      "focus": "conditional"
    },
    {
      "id": "P22",
      "text": "Χθες το βράδυ φάγαμε σε μια ταβέρνα στην Πλάκα.",
      "focus": "χθ cluster, past"
    },
    {
      "id": "P23",
      "text": "Ευχαριστώ πολύ για τη βοήθεια! Να είστε καλά.",
      "focus": "ευ, thanks"
    },
    {
      "id": "P24",
      "text": "Μπορώ να πληρώσω με κάρτα ή μόνο με μετρητά;",
      "focus": "payment, alternative question"
    },
    {
      "id": "P25",
      "text": "Το γραφείο είναι στον τρίτο όροφο, δεξιά από το ασανσέρ.",
      "focus": "ordinals, loanword"
    },
    {
      "id": "P26",
      "text": "Ρε συ, πού χάθηκες; Έχουμε καιρό να τα πούμε!",
      "focus": "informal ρε, Real Greek"
    },
    {
      "id": "P27",
      "text": "Η συνάντηση μεταφέρθηκε για την Πέμπτη στις δέκα.",
      "focus": "φθ cluster, schedule"
    },
    {
      "id": "P28",
      "text": "Θα ήθελα να ανοίξω λογαριασμό στην τράπεζα.",
      "focus": "bank, θα ήθελα"
    },
    {
      "id": "P29",
      "text": "Ο Νίκος σπουδάζει ψυχολογία στο Ηράκλειο.",
      "focus": "ψ, toponym"
    },
    {
      "id": "P30",
      "text": "Όχι, δεν είναι αυτό. Εννοούσα το άλλο, το μπλε.",
      "focus": "correction, contrast"
    }
  ],
